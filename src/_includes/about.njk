---
layout: base.njk
---
<header class="narrow page-head">
  <span class="label">{{ title }}</span>
  <h1>{{ heading or title }}</h1>
</header>

{% if photo or name or role or linkedin or instagram or email %}
<section class="narrow about-intro" aria-label="About the editor">
  <div class="about-card">
    {% if photo %}
    <img class="about-photo" src="{{ photo }}" alt="{{ name or 'Photo of the editor' }}" width="240" height="300">
    {% endif %}
    <div class="about-who">
      {% if name %}<h2>{{ name }}</h2>{% endif %}
      {% if role %}<p class="about-role">{{ role }}</p>{% endif %}
      {% if linkedin or instagram or email %}
      <ul class="about-links">
        {% if linkedin %}
        <li><a class="about-btn" href="{{ linkedin }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0"/></svg>
          LinkedIn</a></li>
        {% endif %}
        {% if instagram %}
        <li><a class="about-btn" href="{{ instagram }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5v.01"/></svg>
          Instagram</a></li>
        {% endif %}
        {% if email %}
        <li><a class="about-btn" href="mailto:{{ email }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          {{ email }}</a></li>
        {% endif %}
      </ul>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<div class="prose">
  {{ content | safe }}
</div>
