<li class="post-row{% if not post.data.image %} no-image{% endif %}">
  <div class="text">
    {% if post.data.category %}<span class="label">{{ post.data.category }}</span>{% endif %}
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {% if post.data.summary %}<p>{{ post.data.summary }}</p>{% endif %}
    <span class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | longDate }}</time></span>
  </div>
  {% if post.data.image %}<a href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.data.image }}" alt="" loading="lazy"></a>{% endif %}
</li>
